# Imagen ligera para la API y el worker de ingesta de LangChain Radar
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_CACHE=1 \
    FASTEMBED_CACHE_PATH=/home/radar/.cache/fastembed

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.4.18 /uv /bin/uv

# Instalar dependencias antes de copiar el código para aprovechar la caché de capas
COPY pyproject.toml README.md ./
RUN uv pip install --system -e ".[embeddings]"

COPY config/ ./config/
COPY src/ ./src/

# El subcomando `eval` del CLI reutiliza tests/evaluation
COPY tests/ ./tests/

# Ejecutar sin privilegios de root
RUN useradd --create-home --uid 10001 radar && chown -R radar:radar /app
USER radar

# Por defecto arranca el consumidor de Redis Streams
CMD ["python", "-m", "src.interfaces.cli.manage", "worker"]
