# Multi-stage lightweight Dockerfile for LangChain Radar Worker & Ingestion
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.4.18 /uv /bin/uv

COPY pyproject.toml README.md ./

# Install project dependencies including embeddings
RUN uv pip install --system -e ".[embeddings]"

# Copy source code and configurations
COPY config/ ./config/
COPY src/ ./src/
COPY tests/ ./tests/

# Default entrypoint runs the Redis Streams event consumer
CMD ["python", "-m", "src.interfaces.cli.manage", "worker"]
